; STM32F103C8 链接布局。RESET 向量位于代码区首地址，RW/ZI/栈/堆位于 SRAM。
; 从 0x0800F800 开始的两个 1 KiB Flash 页用于校准日志，不进入固件链接区域。
; 本文件只定义程序与数据的地址，不负责 OLED 内容。

LR_IROM1 0x08000000 0x0000F800 {
  ER_IROM1 0x08000000 0x0000F800 {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00005000 {
    .ANY (+RW +ZI)
  }
}
